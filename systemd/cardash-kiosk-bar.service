[Unit]
Description=OpenDash Kiosk - cluster em barra (segunda tela)
After=graphical.target cardash.service
Wants=cardash.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__USER__/.Xauthority
Environment=CARDASH_SCREEN=bar
Environment=CARDASH_WINDOW_SIZE=__BAR_SIZE__
Environment=CARDASH_WINDOW_POS=__BAR_POS__
ExecStart=__DIR__/kiosk/kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
